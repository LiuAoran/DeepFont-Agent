   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Generate dataset\n",
    "from utils.generate_font_images import generate_dataset\n",
    "generate_dataset(output_dir=\"data\", fonts_dir=\"fonts\", num_samples=100)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Define CNN Model\n",
    "import torch.nn as nn\n",
    "class DeepFontModel(nn.Module):\n",
    "    def __init__(self):\n",
    "        super(DeepFontModel, self).__init__()\n",
    "        self.conv = nn.Sequential(\n",
    "            nn.Conv2d(3, 32, kernel_size=3, stride=1, padding=1),\n",
    "            nn.ReLU(),\n    "            nn.MaxPool2d(kernel_size=2, stride=2)\n",
    "        )\n",
    "        self.fc = nn.Sequential(\n",
    "            nn.Linear(32 * 112 * 112, 128),\n    "            nn.ReLU(),\n    "            nn.Linear(128, 10)\n    "        )\n    "\n    "    def forward(self, x):\n    "        x = self.conv(x)\n    "        x = x.view(x.size(0), -1)\n    "        x = self.fc(x)\n    "        return x\n"
   ]
  },
